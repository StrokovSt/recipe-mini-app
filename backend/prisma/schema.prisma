generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Адрес с пулом соединений для приложения. Миграции берут DIRECT_URL из prisma.config.ts
  url      = env("DATABASE_URL")
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  recipes   Recipe[]
  createdAt DateTime @default(now())
  iconName String?
  // Резервная категория «Разное»: одна на пользователя, удалить нельзя
  isDefault Boolean  @default(false)

  @@unique([userId, name])
  @@index([userId])
}

model Recipe {
  id           String    @id @default(cuid())
  userId       String
  title        String
  description  String?
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id])
  // IngredientGroup[] и RecipeStep[] из @recipe/common
  ingredients  Json
  steps        Json
  // Время в минутах
  prepTime     Int?
  cookTime     Int?
  servings     Int?
  // КБЖУ на одну порцию: ккал и граммы белков, жиров, углеводов. null — неизвестно
  calories     Int?
  protein      Int?
  fat          Int?
  carbs        Int?
  sourceUrl    String
  source       String    @default("other")
  telegraphUrl String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  media        Media[]
  tags         RecipeTag[]

  @@index([userId])
  @@index([userId, categoryId])
}

model Media {
  id        String   @id @default(cuid())
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  url       String
  type      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Tag {
  id      String      @id @default(cuid())
  userId  String
  name    String
  recipes RecipeTag[]

  @@unique([userId, name])
  @@index([userId])
}

model RecipeTag {
  recipeId String
  tagId    String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
}

// Черновик формы рецепта. data — JSON значений формы, проверяется при сохранении рецепта
model Draft {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("")
  // "ai" | "manual"
  origin    String   @default("manual")
  source    String   @default("other")
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model User {
    // Старые пользователи из Телеграма сохранили Telegram id, новые получают случайный id
    id            String    @id
    name          String    @default("")
    // Better Auth требует email. У входа только через Телеграм — служебный <id>@telegram.invalid, в интерфейсе не показывается
    email         String    @unique
    emailVerified Boolean   @default(false)
    image         String?
    plan          Plan      @default(FREE)
    planExpiry    DateTime?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    // Настройки интерфейса, null — автоопределение на устройстве
    language      String?
    theme         String?   // "light" | "dark"
    animations    Boolean?

    // Можно ли распознавать рецепты через ИИ
    aiEnabled     Boolean   @default(true)

    sessions      Session[]
    accounts      Account[]
}

// Сессия входа на сайте (кука). В мини-аппе сессии нет: каждый запрос подписан initData
model Session {
    id        String   @id
    token     String   @unique
    expiresAt DateTime
    ipAddress String?
    userAgent String?
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
}

// Способ входа: providerId "telegram" | "google", accountId — id пользователя у этого сервиса
model Account {
    id                    String    @id
    accountId             String
    providerId            String
    userId                String
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    // Один Телеграм или Google — только у одного аккаунта
    @@unique([providerId, accountId])
    @@index([userId])
}

// Временные коды Better Auth (state при входе через Google и т.п.)
model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
}

enum Plan {
    FREE
    PRO
}