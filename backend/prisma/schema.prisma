generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Адрес с пулом соединений для приложения. Миграции берут DIRECT_URL из prisma.config.ts
  url      = env("DATABASE_URL")
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  recipes   Recipe[]
  createdAt DateTime @default(now())
  iconName String?
  // Резервная категория «Разное»: одна на пользователя, удалить нельзя
  isDefault Boolean  @default(false)

  @@unique([userId, name])
  @@index([userId])
}

model Recipe {
  id           String    @id @default(cuid())
  userId       String
  title        String
  description  String?
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id])
  // IngredientGroup[] и RecipeStep[] из @recipe/common
  ingredients  Json
  steps        Json
  // Время в минутах
  prepTime     Int?
  cookTime     Int?
  servings     Int?
  // КБЖУ на одну порцию: ккал и граммы белков, жиров, углеводов. null — неизвестно
  calories     Int?
  protein      Int?
  fat          Int?
  carbs        Int?
  sourceUrl    String
  source       String    @default("other")
  telegraphUrl String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  media        Media[]
  tags         RecipeTag[]

  @@index([userId])
  @@index([userId, categoryId])
}

model Media {
  id        String   @id @default(cuid())
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  url       String
  type      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Tag {
  id      String      @id @default(cuid())
  userId  String
  name    String
  recipes RecipeTag[]

  @@unique([userId, name])
  @@index([userId])
}

model RecipeTag {
  recipeId String
  tagId    String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
}

// Черновик формы рецепта. data — JSON значений формы, проверяется при сохранении рецепта
model Draft {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("")
  // "ai" | "manual"
  origin    String   @default("manual")
  source    String   @default("other")
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model User {
    id          String    @id  // telegram user id
    plan        Plan      @default(FREE)
    planExpiry  DateTime?
    createdAt   DateTime  @default(now())

    // Настройки интерфейса, null — автоопределение на устройстве
    language    String?
    theme       String?   // "light" | "dark"
    animations  Boolean?

    // Можно ли распознавать рецепты через ИИ
    aiEnabled   Boolean   @default(true)
}

enum Plan {
    FREE
    PRO
}